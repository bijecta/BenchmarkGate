<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>benchmark-gate</ToolCommandName>
    <PackageId>Bijecta.BenchmarkGate.Tool</PackageId>
    <Description>Local-first performance regression gate for BenchmarkDotNet. No SaaS, no hosted database — baselines and policies are reviewable repository artifacts.</Description>
    <RootNamespace>Bijecta.BenchmarkGate.Tool</RootNamespace>
    <PackageReadmeFile>README.md</PackageReadmeFile>
	<PackageIcon>benchmarkgate-nuget-128.png</PackageIcon>
    <!--
      v0.1.0-alpha.1: set explicitly here until the tag-driven release
      workflow (Day 5) computes Version from the pushed git tag.
    -->
    <Version>0.1.0-alpha.1</Version>
  </PropertyGroup>

  <ItemGroup>
	<InternalsVisibleTo Include="BenchmarkGate.Tool.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
	<None Include="..\..\.github\assets\benchmarkgate-nuget-128.png" Pack="true" PackagePath="" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BenchmarkGate.BenchmarkDotNet\BenchmarkGate.BenchmarkDotNet.csproj" />
    <ProjectReference Include="..\BenchmarkGate.Core\BenchmarkGate.Core.csproj" />
    <ProjectReference Include="..\BenchmarkGate.Reporting\BenchmarkGate.Reporting.csproj" />
    <ProjectReference Include="..\BenchmarkGate.Storage.FileSystem\BenchmarkGate.Storage.FileSystem.csproj" />
  </ItemGroup>

</Project>
